<?xml version="1.0" encoding="UTF-8"?>
<!--
  PARTIAL schema, written by hand from the DUIS 5.5 request examples of the Reference Test Data Set (RTDS 4.10.0).
  It is NOT the DUIS schema, which DCC has not provided: it describes only the requests the EDT sends today.
  Replace it with the DUIS XSD when DCC provides it; only XmlServiceRequestReader depends on it.

  What it checks, beyond the real shape of the header and the body:
    - CommandVariant is 1, the value of the non-critical read requests in the released data (Table 8 of the RTDS notes);
    - the Body is exactly one of the request elements below (SRV 4.1.1, 8.9, 6.2.9, 6.30 and 11.2), empty as in the examples;
    - the request is unsigned: the signature is added by the signer after this check.
  Adding an SRV means adding its ServiceReference, its ServiceReferenceVariant and its body element here, and its
  allowlist entry in the signer's configuration.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.dccinterface.co.uk/ServiceUserGateway"
           xmlns="http://www.dccinterface.co.uk/ServiceUserGateway"
           elementFormDefault="qualified">

  <xs:element name="Request">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Header">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="RequestID" type="RequestId"/>
              <xs:element name="CommandVariant" type="NonCriticalCommandVariant"/>
              <xs:element name="ServiceReference" type="ServiceReference"/>
              <xs:element name="ServiceReferenceVariant" type="ServiceReferenceVariant"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Body">
          <xs:complexType>
            <xs:choice>
              <!-- SRV 4.1.1 Read Instantaneous Import Registers -->
              <xs:element name="ReadInstantaneousImportRegisters"><xs:complexType/></xs:element>
              <!-- SRV 8.9 Read Device Log -->
              <xs:element name="ReadDeviceLog"><xs:complexType/></xs:element>
              <!-- SRV 6.2.9 Read Device Configuration (Payment Mode) -->
              <xs:element name="ReadDeviceConfigurationPaymentMode"><xs:complexType/></xs:element>
              <!-- SRV 6.30 Read CHF Sub GHz Configuration -->
              <xs:element name="ReadCHFSubGHzConfiguration"><xs:complexType/></xs:element>
              <!-- SRV 11.2 Read Firmware Version -->
              <xs:element name="ReadFirmwareVersion"><xs:complexType/></xs:element>
            </xs:choice>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="schemaVersion" type="xs:string" use="required" fixed="5.5"/>
    </xs:complexType>
  </xs:element>

  <!-- originator ID:target device ID:counter, as in the examples (for example 90-B3-D5-1F-30-01-00-00:00-DB-12-34-56-78-90-A0:1000) -->
  <xs:simpleType name="RequestId">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9A-F]{2}(-[0-9A-F]{2}){7}:[0-9A-F]{2}(-[0-9A-F]{2}){7}:[0-9]+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NonCriticalCommandVariant">
    <xs:restriction base="xs:int">
      <xs:enumeration value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ServiceReference">
    <xs:restriction base="xs:string">
      <xs:enumeration value="4.1"/>
      <xs:enumeration value="8.9"/>
      <xs:enumeration value="6.2"/>
      <xs:enumeration value="6.30"/>
      <xs:enumeration value="11.2"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ServiceReferenceVariant">
    <xs:restriction base="xs:string">
      <xs:enumeration value="4.1.1"/>
      <xs:enumeration value="8.9"/>
      <xs:enumeration value="6.2.9"/>
      <xs:enumeration value="6.30"/>
      <xs:enumeration value="11.2"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
