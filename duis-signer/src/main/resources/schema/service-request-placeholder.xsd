<?xml version="1.0" encoding="UTF-8"?>
<!--
  PLACEHOLDER schema, invented for this learning project. It is NOT the DUIS schema.
  Replace it with the real DUIS XSD when DCC provides it; only XmlServiceRequestReader depends on it.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:edt:placeholder:duis"
           xmlns="urn:edt:placeholder:duis"
           elementFormDefault="qualified">

  <xs:element name="ServiceRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Header">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="RequestId" type="NonEmpty"/>
              <xs:element name="Originator" type="NonEmpty"/>
              <xs:element name="SRV" type="NonEmpty"/>
              <xs:element name="DeviceType" type="NonEmpty"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <!-- The command itself: any content, not checked by this placeholder. -->
        <xs:element name="Body">
          <xs:complexType>
            <xs:sequence>
              <xs:any processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:simpleType name="NonEmpty">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
